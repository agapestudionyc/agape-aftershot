          "type": "image/png",
          "purpose": "any"
        },
        {
          "src": "/static/shortcut-aftershot-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        },
        {
          "src": "/static/shortcut-aftershot-maskable-192.png",
